{
  "id": "aibang-hr-onboarding-test",
  "name": "Aibang HR Onboarding Synthetic Skill Runtime",
  "description": "Run controlled synthetic HR onboarding Skills and retain the deprecated Step 1 compatibility tool.",
  "version": "0.2.5",
  "categories": ["other"],
  "contracts": {
    "tools": [
      "aibang_hr_onboarding_task_navigation",
      "aibang_hr_onboarding_case_intake",
      "aibang_hr_onboarding_requirement_tracking",
      "aibang_hr_onboarding_status_control",
      "aibang_hr_onboarding_coordination",
      "aibang_hr_onboarding_delivery",
      "aibang_hr_onboarding_test_ready_card"
    ]
  },
  "toolMetadata": {
    "aibang_hr_onboarding_task_navigation": { "optional": true },
    "aibang_hr_onboarding_case_intake": { "optional": true },
    "aibang_hr_onboarding_requirement_tracking": { "optional": true },
    "aibang_hr_onboarding_status_control": { "optional": true },
    "aibang_hr_onboarding_coordination": { "optional": true },
    "aibang_hr_onboarding_delivery": { "optional": true },
    "aibang_hr_onboarding_test_ready_card": { "optional": true }
  },
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["trustedPrincipals", "databasePath", "repositoryRoot"],
    "properties": {
      "trustedPrincipals": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "senderId", "tenantId", "dataSpaceId", "actorId", "activeTeamId", "teamMembershipRef", "roles", "scopeGrantRefs"],
          "properties": {
            "accountId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
            "senderId": { "type": "string", "pattern": "^ou_[A-Za-z0-9]+$" },
            "tenantId": { "type": "string", "minLength": 1 },
            "dataSpaceId": { "type": "string", "minLength": 1 },
            "actorId": { "type": "string", "minLength": 1 },
            "activeTeamId": { "type": "string", "minLength": 1 },
            "teamMembershipRef": { "type": "string", "minLength": 1 },
            "roles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "scopeGrantRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      },
      "databasePath": { "type": "string", "pattern": "^/" },
      "repositoryRoot": { "type": "string", "pattern": "^/" }
    }
  }
}

